{
  "name": "@four-bytes/four-opencode-supertools",
  "version": "0.11.0",
  "description": "Token-efficient supertools for opencode agents — patch_file via unified diff and more",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/four-opencode-supertools.d.ts",
      "import": "./dist/four-opencode-supertools.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/four-bytes/four-opencode-supertools"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "Four Bytes",
  "scripts": {
    "postinstall": "bun run build",
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/four-opencode-supertools.ts --outdir dist --target bun --format esm --splitting && cp node_modules/web-tree-sitter/web-tree-sitter.wasm dist/ && cp node_modules/tree-sitter-php/tree-sitter-php.wasm dist/",
    "test": "bun test",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.15.13",
    "tree-sitter-php": "^0.24.2",
    "web-tree-sitter": "^0.26.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "~1.3.14",
    "@typescript-eslint/eslint-plugin": "8.62.1",
    "@typescript-eslint/parser": "8.61.0",
    "bun-types": "latest",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.0"
  }
}
